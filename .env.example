# Configurações de Banco de Dados
DB_HOST=localhost
DB_USER=root
DB_PASS=sua_senha_segura
DB_NAME=soluteg_fin
DB_PORT=3306
DATABASE_URL="mysql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Autenticação (NextAuth)
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="gere_uma_chave_secreta_aleatoria_aqui"

# Google OAuth (Obtenha no Google Cloud Console)
AUTH_GOOGLE_ID="seu_client_id_do_google"
AUTH_GOOGLE_SECRET="seu_client_secret_do_google"

# Web Push (gere as chaves com: npx web-push generate-vapid-keys --json)
# A chave pública precisa estar em DUAS variáveis (servidor e cliente) com o mesmo valor.
VAPID_PUBLIC_KEY="sua_vapid_public_key"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="sua_vapid_public_key"
VAPID_PRIVATE_KEY="sua_vapid_private_key"
VAPID_SUBJECT="mailto:contato@soluteg.com.br"

# Rotina diária (cron) — segredo para proteger /api/cron/daily
CRON_SECRET="gere_um_segredo_aleatorio_aqui"
