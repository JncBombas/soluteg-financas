generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  image             String?
  accounts          Account[]
  sessions          Session[]
  categories        Category[]
  bankAccounts      BankAccount[]
  creditCards       CreditCard[]
  transactions      Transaction[]
  transactionGroups TransactionGroup[]
}

model BankAccount {
  id             String             @id @default(cuid())
  name           String
  type           String             // "CHECKING" | "SAVINGS" | "DIGITAL" | "INVESTMENT"
  initialBalance Float              @default(0)
  color          String             @default("#C9A96E")
  icon           String?
  isActive       Boolean            @default(true)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  transactionGroups TransactionGroup[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model CreditCard {
  id             String             @id @default(cuid())
  name           String
  brand          String             // "VISA" | "MASTERCARD" | "ELO" | "AMEX" | "HIPERCARD" | "OTHER"
  lastFourDigits String?
  closingDay     Int
  dueDay         Int
  limit          Float
  color          String             @default("#C9A96E")
  isActive       Boolean            @default(true)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  transactionGroups TransactionGroup[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model Category {
  id                String             @id @default(cuid())
  name              String
  type              String             // "INCOME" | "EXPENSE"
  nature            String             @default("VARIABLE")
  context           String             @default("PERSONAL")
  group             String             @default("Outros")
  isDefault         Boolean            @default(false)
  color             String?
  icon              String?
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  transactionGroups TransactionGroup[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  @@unique([name, userId])
}

model TransactionGroup {
  id              String        @id @default(cuid())
  description     String
  groupType       String        // "INSTALLMENT" | "RECURRING"
  transactionType String        // "INCOME" | "EXPENSE"
  paymentMethod   String        // "CASH" | "DEBIT" | "CREDIT" | "PIX" | "BOLETO" | "TRANSFER"
  totalAmount     Float
  occurrences     Int
  dueDay          Int?
  startDate       DateTime
  notes           String?       @db.Text
  creditCardId    String?
  creditCard      CreditCard?   @relation(fields: [creditCardId], references: [id])
  bankAccountId   String?
  bankAccount     BankAccount?  @relation(fields: [bankAccountId], references: [id])
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  createdAt       DateTime      @default(now())
}

model Transaction {
  id                 String            @id @default(cuid())
  amount             Float
  description        String
  date               DateTime
  dueDate            DateTime?
  type               String            // "INCOME" | "EXPENSE"
  paymentMethod      String            @default("CASH")
  status             String            @default("PAID")
  fee                Float?
  paidAt             DateTime?
  notes              String?           @db.Text
  occurrenceNumber   Int?
  occurrenceTotal    Int?
  creditCardId       String?
  creditCard         CreditCard?       @relation(fields: [creditCardId], references: [id])
  bankAccountId      String?
  bankAccount        BankAccount?      @relation(fields: [bankAccountId], references: [id])
  transactionGroupId String?
  transactionGroup   TransactionGroup? @relation(fields: [transactionGroupId], references: [id])
  categoryId         String
  category           Category          @relation(fields: [categoryId], references: [id])
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}
